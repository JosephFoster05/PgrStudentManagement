@model PgrStudentManagement.Models.Student

@{
    ViewData["Title"] = "Update Student Status";
}

<h1>Update Student Status</h1>

<p class="alert alert-info">
    
</p>


<form asp-action="EditStatus" method="post">
    <input type="hidden" asp-for="StudentNumber" />
    <div class="form-group">
        <label asp-for="Status" class="control-label"></label>
        <select asp-for="Status" class="form-control" asp-items="Html.GetEnumSelectList<PgrStudentManagement.Models.Status>()"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>

<a asp-action="Index">Return to students</a>